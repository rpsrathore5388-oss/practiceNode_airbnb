<%- include('partials/head') %>
<style>
    *::-webkit-scrollbar{
    display: none;
    }
</style>
    </head>

    <body>
        <%- include('partials/nav') %>
            <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-xl">
                <h2 class="text-3xl font-bold mb-6 text-red-500 text-center">
                    Here are our registered Homes:
                </h2>
                <div class="space-y-4 overflow-y-scroll max-h-[65vh]">
                    <% registeredHomes.forEach(home=> { %>
                        <div class="max-w-sm bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition duration-300">
                            <div class="relative">
                                <img src="<%= home.photoUrl %>" alt="House Image" class="w-full h-56 object-cover" />
                                <span
                                    class="absolute top-3 right-3 bg-white/90 backdrop-blur px-3 py-1 rounded-full text-sm font-semibold text-gray-800 shadow">
                                    <%= home.rating %> ⭐
                                </span>
                            </div>

                            <div class="p-5">
                                <h2 class="text-xl font-bold text-gray-900">
                                    <%= home.name %>
                                </h2>

                                <p class="flex items-center text-gray-500 text-sm mt-1">
                                    📍 <%= home.location %>
                                </p>

                                <div class="flex items-center justify-between mt-4">
                                    <p class="text-2xl font-extrabold text-red-600">
                                        ₹<%= home.price %>
                                    </p>
                                    <button
                                        class="bg-red-600 hover:bg-red-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
                                        Book Now
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </main>
    </body>

    </html>